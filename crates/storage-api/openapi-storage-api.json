{
  "openapi": "3.1.0",
  "info": {
    "title": "Storage API",
    "description": "",
    "license": {
      "name": "BUSL-1.1",
      "identifier": "BUSL-1.1"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/pubsub": {
      "post": {
        "tags": [
          "crate::routes::pubsub"
        ],
        "operationId": "pubsub_endpoint",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SNS-compatible response"
          }
        }
      }
    },
    "/queue": {
      "post": {
        "tags": [
          "crate::routes::queue"
        ],
        "summary": "Dispatch queue operations.",
        "description": "Dispatches SQS-compatible operations and the native JSON AmazonSQS.PublishMessage extension. PublishMessage accepts MessageId (a hyphenated UUID, excluding the nil UUID) and Message (a SendMessage request). Repeating an existing identity preserves its pending delivery, receipt, visibility, expiry and checkpoint. Different body or attributes conflict. A missing or expired delivery can be recovered from its retained source intent.",
        "operationId": "queue_endpoint",
        "requestBody": {
          "content": {
            "application/x-amz-json-1.0": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SQS-compatible response; PublishMessage returns the retained message identity and message checksums"
          },
          "400": {
            "description": "Invalid queue request or publication identity reused with different immutable content"
          },
          "503": {
            "description": "Storage or admission unavailable; follow Retry-After"
          }
        }
      }
    },
    "/queue/{account}/{queue_name}": {
      "post": {
        "tags": [
          "crate::routes::queue"
        ],
        "summary": "Dispatch queue operations posted to a queue URL.",
        "description": "The same operations as `/queue`. A request with no QueueUrl member acts on the queue of the path. A QueueUrl member wins over the path. A path account other than the configured account answers AWS.SimpleQueueService.NonExistentQueue.",
        "operationId": "queue_url_endpoint",
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "description": "The configured 12-digit account",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{12}$"
            }
          },
          {
            "name": "queue_name",
            "in": "path",
            "description": "The queue name",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,80}$"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SQS-compatible response"
          },
          "400": {
            "description": "Invalid queue request, or no such queue"
          },
          "503": {
            "description": "Storage or admission unavailable; follow Retry-After"
          }
        }
      }
    },
    "/storage": {
      "post": {
        "tags": [
          "crate::routes::dynamodb"
        ],
        "summary": "Execute a DynamoDB-compatible storage operation.",
        "description": "Sends a DynamoDB-compatible JSON-RPC request through the storage API using the `x-amz-target` header. `DynamoDB_20120810.QuerySourcePage` is an Aux extension, not a standard DynamoDB operation. It accepts a snake_case QueryTableRequest and runs the same query as the Rust query_table method, but returns each item together with its decoded storage key (ItemKey). The key contains table/index identity and partition/sort key values, not raw backend key bytes or SQL row locations. Both methods return evaluated item/byte counts and a continuation token. projection_expression applies to returned items; an index query returns its stored projection without fetching complete base-table items. Use query_table for ordinary item reads, query_table_stored_entity for automatic typed entity identity checks, or QuerySourcePage when code needs the storage key separately from item attributes. It requires an Aux server; AWS DynamoDB does not implement it.",
        "operationId": "dynamodb_endpoint",
        "parameters": [
          {
            "name": "x-amz-target",
            "in": "header",
            "description": "DynamoDB operation target (e.g., DynamoDB_20120810.CreateTable)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "DynamoDB operation successful",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Admission overloaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-aux-audience": "internal_private",
        "x-aux-internal": true
      }
    }
  },
  "components": {
    "schemas": {
      "AttributeMap": {
        "type": "object",
        "description": "Equality treats attributes as a map; iteration and serialization retain\ninsertion order.",
        "additionalProperties": {
          "$ref": "#/components/schemas/AttributeValue"
        },
        "propertyNames": {
          "type": "string"
        }
      },
      "AttributeValue": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "S"
            ],
            "properties": {
              "S": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "N"
            ],
            "properties": {
              "N": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "B"
            ],
            "properties": {
              "B": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "SS"
            ],
            "properties": {
              "SS": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "NS"
            ],
            "properties": {
              "NS": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "BS"
            ],
            "properties": {
              "BS": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "BOOL"
            ],
            "properties": {
              "BOOL": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "NULL"
            ],
            "properties": {
              "NULL": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "L"
            ],
            "properties": {
              "L": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AttributeValue"
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "M"
            ],
            "properties": {
              "M": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/AttributeValue"
                },
                "propertyNames": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "DynamoDbCancellationReason": {
        "type": "object",
        "required": [
          "Code"
        ],
        "properties": {
          "Code": {
            "type": "string"
          },
          "Item": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AttributeMap"
              },
              {
                "type": "null"
              }
            ]
          },
          "Message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "__type"
        ],
        "properties": {
          "CancellationReasons": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/DynamoDbCancellationReason"
            },
            "description": "DynamoDB transaction cancellation reasons."
          },
          "Item": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AttributeMap",
                "description": "DynamoDB item returned by ReturnValuesOnConditionCheckFailure."
              },
              {
                "type": "null"
              }
            ]
          },
          "Message": {
            "type": [
              "string",
              "null"
            ],
            "description": "DynamoDB transaction cancellation message field."
          },
          "__type": {
            "type": "string",
            "description": "AWS-compatible JSON error field name. DynamoDB and SQS JSON protocol\nerrors use `__type`. Machine-readable API error type.",
            "example": "ValidationException"
          },
          "documentation_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional documentation link for operator or developer remediation.",
            "example": "/docs/explanations/error-code-catalog"
          },
          "message": {
            "type": "string",
            "description": "AWS-compatible JSON error field name. DynamoDB and SQS JSON protocol\nerrors use `message`. Human-readable error message.",
            "example": "One or more parameter values were invalid."
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Request correlation identifier echoed in the response body.",
            "example": "018f1f61-2a6f-7ac3-b9b6-7f65bb2d91fd"
          },
          "retry_after_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Optional retry budget for rate-limited responses.",
            "example": 2,
            "minimum": 0
          }
        }
      }
    }
  }
}
